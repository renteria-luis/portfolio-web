# Copy to .env.local for local development, and set the same keys in
# Vercel > Project > Settings > Environment Variables for production.
#
# Anything prefixed with VITE_ is compiled into the public JavaScript bundle
# and is readable by anyone. Everything else is only ever read inside
# api/contact.js, which runs on the server. Never move a secret across that
# line.

# ── Client (public by design) ────────────────────────────────────────────
# Cloudflare Turnstile site key. Public: it identifies the widget, it does not
# authorise anything. dash.cloudflare.com > Turnstile > your widget.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ── Server only (secret) ─────────────────────────────────────────────────
# resend.com > API Keys. Needs "Sending access" only.
RESEND_API_KEY=re_...

# Cloudflare Turnstile secret key, from the same widget as the site key above.
# If this is unset the endpoint still works but skips captcha verification,
# which is fine locally and not fine in production.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Where form submissions land.
CONTACT_TO=luisrenterialezano@gmail.com

# The visible sender. The domain MUST be verified in Resend, otherwise DMARC
# rejects the mail. The visitor's address goes in Reply-To, never here.
CONTACT_FROM=Portfolio <contacto@luisrenteria.me>

# Set to 1 to also send a confirmation to whoever filled the form.
# Left off by default: it makes this endpoint send mail to an address supplied
# by the caller, which becomes a spam relay if the captcha is ever bypassed.
CONTACT_AUTOREPLY=0
